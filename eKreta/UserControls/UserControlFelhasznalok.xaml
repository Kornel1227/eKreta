<UserControl
    x:Class="eKreta.UserControls.UserControlFelhasznalok"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:eKreta.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <StackPanel>
        <DataGrid x:Name ="datagridfelhasznalok" 
                  Width="1100" 
                  Height="600" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionChanged="datagridfelhasznalok_SelectionChanged"
                  >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}"/>
                <DataGridTextColumn Header="Felhasználónév" Binding="{Binding FelhasznaloNev}"/>
                <DataGridTextColumn Header="Teljesnév" Binding="{Binding TeljesNev}"/>
                <DataGridTextColumn Header="Szerepkör id" Binding="{Binding Szerepkor}"/>
                <DataGridTextColumn Header="Szerepkör név" Binding="{Binding SzerepkorNev}"/> 
                
            </DataGrid.Columns>

        </DataGrid>
        <WrapPanel>
            <StackPanel >
                
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
